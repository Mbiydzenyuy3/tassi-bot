# Copy this file to .env and fill in real values before running locally.
# .env is gitignored; this file is committed as the canonical reference.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://tassi:tassi@localhost:5432/tassi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────────────────
# Obtain these from https://developers.facebook.com → your WhatsApp Business app
META_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-app-secret
META_PHONE_NUMBER_ID=your-phone-number-id
META_ACCESS_TOKEN=your-permanent-access-token

# ── Campay (MTN MoMo / Orange Money) ──────────────────────────────────────────
# Obtain these from https://campay.net → developer portal
CAMPAY_USERNAME=your-campay-username
CAMPAY_PASSWORD=your-campay-password
CAMPAY_APPLICATION_TOKEN=your-application-token
# Demo/staging: https://demo.campay.net/api  |  Production: https://campay.net/api
CAMPAY_BASE_URL=https://campay.net/api

# ── Tax engine (SRS NFR-MAINT-1 — change without code deploy) ────────────────
RATE_RSI=0.055
# ADDITIVE | INCLUDED | UNCONFIRMED  — set to ADDITIVE or INCLUDED once Gate G1 resolves
CAC_MODE=UNCONFIRMED
CAC_RATE=0.10

# ── Tassi Plus ────────────────────────────────────────────────────────────────
PLUS_PRICE_XAF=500
# Set to true once Gate G3 resolves (Wizard-of-Oz pilot complete)
FEATURE_PLUS_REMINDERS=false

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
# Max WhatsApp messages accepted per MSISDN per 60-second window (FR-DATA-3)
RATE_LIMIT_PER_60S=10
